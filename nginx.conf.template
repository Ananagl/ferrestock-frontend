# Nombre:                 nginx.conf.template
# Descripción:            Sirve la SPA con rutas del lado del cliente y reenvía /api y /actuator al backend (ADR-04).
# Fecha de creación:      2026-10-15
# Fecha de actualización: 2026-10-15
# Autores:                Ana Sofía Nagles García, María Mercedes Rincón Valencia, Juan David Camacho Tapiero
# Versión:                0.12.0
server {
    listen 80;
    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    location /api/ { proxy_pass ${BACKEND_URL}; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
    location /actuator/health { proxy_pass ${BACKEND_URL}; }
    location / { try_files $uri /index.html; }
}
